{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "weight": {
      "type": "decimal"
    },
    "boxTypeId": {
      "type": "enumeration",
      "enum": [
        "box1: پاکت نامه A5 (22×11×2)",
        "box2: پاکت نامه A4 (31×22×2)",
        "box3: پاکت نامه A3 (45×30×2)",
        "box4: جعبه سایز 1 (10×10×15)",
        "box5: جعبه سایز 2 (15×10×20)",
        "box6: جعبه سایز 3 (20×15×20)",
        "box7: جعبه سایز 4 (20×20×30)",
        "box8: جعبه سایز 5 (25×25×35)",
        "box9: جعبه سایز 6 (25×20×45)",
        "box10: جعبه سایز 7 (30×25×40)",
        "box11: جعبه سایز 8 (40×30×45)",
        "box12: جعبه سایز 9 (45×35×50)"
      ],
      "required": false
    },
    "isFragile": {
      "type": "boolean",
      "default": false
    },
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "shortDescription": {
      "type": "text",
      "required": false
    },
    "description": {
      "type": "blocks"
    },
    "content": {
      "type": "text",
      "required": false
    },
    "specifications": {
      "type": "json",
      "required": false
    },
    "price": {
      "type": "decimal"
    },
    "purchasePrice": {
      "type": "decimal"
    },
    "discountPercent": {
      "type": "integer",
      "min": 0,
      "max": 100,
      "default": 0
    },
    "discountUntil": {
      "type": "datetime"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "stock": {
      "type": "integer",
      "default": 0
    },
    "isAvailable": {
      "type": "boolean",
      "default": true
    },
    "shippingOrigin": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::shipping-origin.shipping-origin"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "mappedBy": "products"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "products"
    },
    "comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comment.comment",
      "mappedBy": "product"
    }
  }
}
