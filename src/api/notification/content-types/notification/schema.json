{
  "kind": "collectionType",
  "collectionName": "notifications",
  "info": {
    "singularName": "notification",
    "pluralName": "notifications",
    "displayName": "Notification"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "confirmed",
        "payment_failed",
        "pending_verification",
        "rejected",
        "mentor_reply",
        "support_reply",
        "system_alert",
        "order_status",
        "new_message "
      ],
      "default": "system_alert"
    },
    "notifMessage": {
      "type": "text",
      "required": true
    },
    "hint": {
      "type": "text"
    },
    "link": {
      "type": "string"
    },
    "isRead": {
      "type": "boolean",
      "default": false
    },
    "eventKey": {
      "type": "string"
    },
    "rawId": {
      "type": "string"
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "notifications"
    }
  }
}
