{
  "kind": "collectionType",
  "collectionName": "comments",
  "info": {
    "singularName": "comment",
    "pluralName": "comments",
    "displayName": "Comment "
  },
  "displayField": "content",
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "content": {
      "type": "text",
      "required": true
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "comments"
    },
    "article": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::article.article",
      "inversedBy": "comments"
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "comments"
    },
    "comment_replies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comment.comment",
      "mappedBy": "comment_parent"
    },
    "comment_parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::comment.comment",
      "inversedBy": "comment_replies"
    },
    "product": {  
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "inversedBy": "comments"
    },
    "rating": {
      "type": "integer",
      "min": 0,
      "max": 5
    },
    "isApproved": {
      "type": "boolean",
      "required": true,
      "default": false
    }
  }
}
