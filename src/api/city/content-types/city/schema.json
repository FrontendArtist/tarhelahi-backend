{
  "kind": "collectionType",
  "collectionName": "cities",
  "info": {
    "singularName": "city",
    "pluralName": "cities",
    "displayName": "شهر",
    "description": "شهر برای انتخاب مبدأ ارسال و آدرس."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "externalId": {
      "type": "integer",
      "required": true,
      "unique": true,
      "min": 1
    },
    "name": {
      "type": "string",
      "required": true
    },
    "province": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::province.province",
      "inversedBy": "cities"
    }
  }
}
