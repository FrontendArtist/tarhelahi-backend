{
  "kind": "collectionType",
  "collectionName": "gateway_review_cases",
  "info": {
    "singularName": "gateway-review-case",
    "pluralName": "gateway-review-cases",
    "displayName": "Gateway Review Case"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "caseId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "clientReferenceCode": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "topUpRequestId": {
      "type": "string",
      "required": true
    },
    "reasonCode": {
      "type": "enumeration",
      "enum": [
        "بدون بازگشت از درگاه",
        "نتیجه نامشخص استعلام",
        "نتیجه نامشخص بازگشت وجه",
        "نتیجه نامشخص ارسال به بای‌مانی",
        "تعارض اطلاعات بانکی"
      ],
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "باز",
        "حل‌شده"
      ],
      "default": "باز",
      "required": true
    },
    "notificationStatus": {
      "type": "enumeration",
      "enum": [
        "در انتظار ارسال",
        "تحویل شده",
        "دارای تعارض"
      ],
      "default": "در انتظار ارسال",
      "required": true
    },
    "notificationError": {
      "type": "string"
    },
    "openedAtUtc": {
      "type": "datetime",
      "required": true
    },
    "resolvedAtUtc": {
      "type": "datetime"
    },
    "outcomeCode": {
      "type": "string"
    },
    "resolutionFinancialReferenceId": {
      "type": "string"
    },
    "resolutionTopUpStatus": {
      "type": "string"
    },
    "topUpStatusAtOpen": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "default": 1
    },
    "resolutionOperationId": {
      "type": "string"
    },
    "resolutionAudit": {
      "type": "json"
    },
    "manualRefundReference": {
      "type": "string"
    }
  }
}
