{
  "kind": "singleType",
  "collectionName": "shipping_settings",
  "info": {
    "singularName": "shipping-setting",
    "pluralName": "shipping-settings",
    "displayName": "تنظیمات ارسال"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "costMode": {
      "type": "enumeration",
      "enum": ["نرخ ثابت", "پستکس (استعلام آنلاین)"],
      "default": "پستکس (استعلام آنلاین)"
    },
    "collectionType": {
      "type": "enumeration",
      "enum": ["جمع‌آوری توسط پیک", "تحویل توسط خودمان", "تحویل در دفتر پستی"],
      "default": "تحویل توسط خودمان"
    },
    "courierCode": {
      "type": "enumeration",
      "enum": [
        "شرکت ملی پست",
        "چاپار",
        "دکاپست",
        "پست بار",
        "پستکس وان (بین‌شهری)",
        "پستکس وان (درون‌شهری و عادی)",
        "باراکسپرس"
      ],
      "default": "شرکت ملی پست"
    },
    "serviceType": {
      "type": "enumeration",
      "enum": [
        "پست پیشتاز",
        "پست ویژه",
        "پست اکسپرس",
        "چاپار",
        "پست بار اکسپرس",
        "پستکس وان - ویژه - بین شهری",
        "پستکس وان - اکسپرس",
        "پستکس وان - سازمانی",
        "پستکس وان - ویژه - درون شهری",
        "پستکس وان - عادی",
        "دکاپیشرو بین شهری",
        "دکاپیشرو درون شهری",
        "دکابار بین شهری",
        "دکابار شهری",
        "پست بار کیسه‌ای - دکابار (بین شهری)",
        "پست بار کیسه‌ای - دکابار (درون شهری)",
        "باراکسپرس (ترمینال به درب)",
        "باراکسپرس (ترمینال به ترمینال)"
      ],
      "default": "پست پیشتاز"
    },
    "fixedAmountInNoor": { "type": "biginteger", "min": 0, "default": "170000" },
    "freeShippingThresholdInNoor": { "type": "biginteger", "min": 0 },
    "rialPerNoorForShipping": {
      "type": "biginteger",
      "min": 1,
      "required": true,
      "default": "10"
    }
  }
}
