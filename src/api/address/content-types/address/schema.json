{
  "kind": "collectionType",
  "collectionName": "addresses",
  "info": {
    "singularName": "address",
    "pluralName": "addresses",
    "displayName": "Address"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "mappedBy": "address"
    },
    "title": {
      "type": "string",
      "default": "آدرس خانه"
    },
    "province": {
      "type": "string",
      "required": true
    },
    "city": {
      "type": "string",
      "required": true
    },
    "postalCode": {
      "type": "string"
    },
    "fullAddress": {
      "type": "text",
      "required": true
    },
    "recipientName": {
      "type": "string",
      "required": true
    },
    "recipientPhone": {
      "type": "string",
      "required": true
    }
  }
}
