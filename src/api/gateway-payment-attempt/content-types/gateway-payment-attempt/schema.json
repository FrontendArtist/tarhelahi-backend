{
  "kind": "collectionType",
  "collectionName": "gateway_payment_attempts",
  "info": {
    "singularName": "gateway-payment-attempt",
    "pluralName": "gateway-payment-attempts",
    "displayName": "Gateway Payment Attempt"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "resNum": { "type": "string", "required": true, "unique": true },
    "topUpRequestId": { "type": "string", "required": true },
    "gateway": { "type": "string", "required": true, "default": "SEP" },
    "amountRial": { "type": "decimal", "required": true },
    "status": { "type": "enumeration", "enum": ["ایجاد شده", "توکن صادر شده", "در حال استعلام", "تأیید شده توسط بانک", "تأیید نهایی شده", "نیازمند بررسی", "نیازمند بررسی مالی", "نیازمند بازگشت وجه", "وجه بازگشت داده شده", "ناموفق", "لغو شده", "در انتظار همگام‌سازی"], "default": "ایجاد شده", "required": true },
    "refNum": { "type": "string", "unique": true },
    "rrn": { "type": "string" },
    "originalAmountRial": { "type": "decimal" },
    "affectiveAmountRial": { "type": "decimal" },
    "tokenIssuedAtUtc": { "type": "datetime" },
    "tokenExpiresAtUtc": { "type": "datetime" },
    "verifiedAtUtc": { "type": "datetime" },
    "lastAttemptAtUtc": { "type": "datetime" },
    "retryCount": { "type": "integer", "default": 0 },
    "lastError": { "type": "text" },
    "bankTransactionDateRaw": { "type": "string" },
    "reverseIntentAtUtc": { "type": "datetime" },
    "reverseRetryUntilUtc": { "type": "datetime" },
    "recoveryLeaseUntilUtc": { "type": "datetime" },
    "reviewScanLeaseUntilUtc": { "type": "datetime" }
  }
}
