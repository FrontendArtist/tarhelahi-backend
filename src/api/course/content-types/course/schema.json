{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "Course"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "required": true
    },
    "media": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "teaserUrl": {
      "type": "string"
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "internationalPrice": {
      "type": "integer"
    },
    "isFree": {
      "type": "boolean",
      "default": false
    },
    "discountPercent": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "max": 100
    },
    "discountUntil": {
      "type": "datetime"
    },
    "telegramLink": {
      "type": "string"
    },
    "description": {
      "type": "blocks"
    },
    "isChaptered": {
      "type": "boolean",
      "default": false
    },
    "chapters": {
      "type": "component",
      "component": "course-parts.chapter",
      "repeatable": true
    },
    "users_permissions_users": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "inversedBy": "courses"
    },
    "comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comment.comment",
      "mappedBy": "course"
    },
    "curriculum": {
      "type": "component",
      "component": "course-parts.lesson",
      "repeatable": true
    },
    "content": {
      "type": "richtext"
    }
  }
}
