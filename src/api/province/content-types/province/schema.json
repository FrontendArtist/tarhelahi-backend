{
  "kind": "collectionType",
  "collectionName": "provinces",
  "info": {
    "singularName": "province",
    "pluralName": "provinces",
    "displayName": "استان",
    "description": "استان برای انتخاب مبدأ ارسال و آدرس."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "externalId": {
      "type": "integer",
      "required": true,
      "unique": true,
      "min": 1
    },
    "name": {
      "type": "string",
      "required": true
    },
    "cities": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::city.city",
      "mappedBy": "province"
    }
  }
}
