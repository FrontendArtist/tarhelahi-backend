{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order "
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "inventoryReservationId": { "type": "string", "private": true },
    "shippingAmountInNoor": { "type": "decimal" },
    "shippingRuleLabel": { "type": "string" },
    "addressVersion": { "type": "string" },
    "addressSnapshot": { "type": "json", "private": true },
    "cartSnapshot": { "type": "json", "private": true },
    "fullName": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "text",
      "required": true
    },
    "postalCode": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "notes": {
      "type": "text"
    },
    "totalPrice": {
      "type": "decimal"
    },
    "orderStatus": {
      "type": "enumeration",
      "default": "در انتظار",
      "enum": [
        "ارسال شده",
        "پرداخت شده",
        "در انتظار",
        "لغو شده",
        "تحویل داده شده"
      ]
    },
    "paymentMethod": {
      "type": "enumeration",
      "enum": [
        "آنلاین",
        "کارت به کارت",
        "رایگان"
      ],
      "default": "آنلاین"
    },
    "paymentStatus": {
      "type": "enumeration",
      "enum": [
        "در انتظار پرداخت",
        "در انتظار تأیید",
        "پرداخت شده",
        "ناموفق"
      ],
      "default": "در انتظار پرداخت"
    },
    "receiptImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "trackingNumber": {
      "type": "string"
    },
    "cardHolderName": {
      "type": "string"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "orders"
    },
    "items": {
      "type": "dynamiczone",
      "components": [
        "order.product-order-item",
        "order.course-order-item"
      ]
    },
    "stockDeducted": {
      "type": "boolean",
      "default": false
    },
    "couponCode": {
      "type": "string"
    },
    "discountAmount": {
      "type": "decimal"
    },
    "originalTotalPrice": {
      "type": "decimal"
    },
    "rejectionReason": {
      "type": "text"
    },
    "settlement": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::settlement.settlement",
      "inversedBy": "orders"
    },
    "settledAt": {
      "type": "datetime"
    },
    "refNum": {
      "type": "string"
    },
    "traceNo": {
      "type": "string"
    },
    "rrn": {
      "type": "string"
    },
    "securePan": {
      "type": "string"
    },
    "hashedCardNumber": {
      "type": "string"
    },
    "paymentDate": {
      "type": "datetime"
    },
    "currency": {
      "type": "enumeration",
      "enum": [
        "تومان",
        "نور"
      ]
    },
    "purchaseId": {
      "type": "string"
    }
  }
}
