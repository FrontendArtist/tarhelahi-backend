{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order "
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "text",
      "required": true
    },
    "postalCode": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "notes": {
      "type": "text"
    },
    "totalPrice": {
      "type": "decimal"
    },
    "orderStatus": {
      "type": "enumeration",
      "default": "pending",
      "enum": [
        "shipped",
        "paid",
        "pending",
        "canceled",
        "delivered"
      ]
    },
    "paymentMethod": {
      "type": "enumeration",
      "enum": [
        "online",
        "card_to_card",
        "free"
      ],
      "default": "online"
    },
    "paymentStatus": {
      "type": "enumeration",
      "enum": [
        "pending_payment",
        "pending_verification",
        "paid",
        "failed"
      ],
      "default": "pending_payment"
    },
    "receiptImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "trackingNumber": {
      "type": "string"
    },
    "cardHolderName": {
      "type": "string"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "orders"
    },
    "items": {
      "type": "dynamiczone",
      "components": [
        "order.product-order-item",
        "order.course-order-item"
      ]
    },
    "stockDeducted": {
      "type": "boolean",
      "default": false
    },
    "couponCode": {
      "type": "string"
    },
    "discountAmount": {
      "type": "decimal"
    },
    "originalTotalPrice": {
      "type": "decimal"
    },
    "rejectionReason": {
      "type": "text"
    }
  }
}
