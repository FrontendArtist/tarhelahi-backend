{
  "kind": "collectionType",
  "collectionName": "popup_messages",
  "info": {
    "singularName": "popup-message",
    "pluralName": "popup-messages",
    "displayName": "PopupMessage"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files",
        "images"
      ]
    },
    "link": {
      "type": "string",
      "required": false
    },
    "buttonText": {
      "type": "string",
      "required": false
    },
    "text": {
      "type": "text"
    },
    "isShow": {
      "type": "boolean",
      "required": true,
      "default": false
    }
  }
}
