ش# ------------------------------------------------------------------
# NextAuth Configuration (جدید)
# ------------------------------------------------------------------
# این کلید برای امنیت سشن‌ها حیاتی است. حتماً آن را با یک رشته رندوم تغییر دهید.
NEXTAUTH_SECRET="A_VERY_COMPLEX_RANDOM_SECRET_STRING_FOR_ENCRYPTION_AND_SECURITY" 

# آدرس اجرای محلی پروژه Next.js
NEXTAUTH_URL="http://localhost:3000" 

# ------------------------------------------------------------------
# Strapi Backend Configuration (جدید)
# ------------------------------------------------------------------
# آدرس Strapi - نیاز به NEXT_PUBLIC دارد تا از کامپوننت‌های Client قابل دسترسی باشد
NEXT_PUBLIC_STRAPI_API_URL="http://localhost:1337/api" 

# Google OAuth (در آینده پر می‌شود)
GOOGLE_ID="" 
GOOGLE_SECRET=""