{
  "kind": "singleType",
  "collectionName": "shipping_settings",
  "info": {
    "singularName": "shipping-setting",
    "pluralName": "shipping-settings",
    "displayName": "تنظیمات ارسال"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "costMode": {
      "type": "enumeration",
      "enum": ["fixed", "postex"],
      "default": "fixed"
    },
    "collectionType": {
      "type": "enumeration",
      "enum": ["pick_up", "courier_drop_off", "postex_drop_off"],
      "default": "courier_drop_off"
    },
    "fixedAmountInNoor": { "type": "biginteger", "min": 0 },
    "freeShippingThresholdInNoor": { "type": "biginteger", "min": 0 },
    "rialPerNoorForShipping": {
      "type": "biginteger",
      "min": 1,
      "required": true
    }
  }
}
